                    "INCREASE_PROBABILITY": 0.4
                },
                {
                    "NAME": "humidity",
                    "TYPE": "float",
                    "MIN_VALUE": 45,
                    "MAX_VALUE": 65,
                    "MAX_STEP": 1,
                    "RETAIN_PROBABILITY": 0.5,
                    "INCREASE_PROBABILITY": 0.6
                }
            ]
        }
    ]
}
